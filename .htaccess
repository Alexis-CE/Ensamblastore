Options -Indexes

RewriteEngine On

# carpetas internas: no se sirven por HTTP (PHP sigue pudiendo incluirlas)
RewriteRule ^(database|includes|herramientas)(/|$) - [F,L]

RewriteRule ^(gracias|privacidad)/?$ seccion.php?vista=$1 [QSA,L,NC]

# archivos que no deben ser publicos
<FilesMatch "\.(sql|md)$|^CAMBIOS_.*\.txt$|^LEEME\.txt$">
    Require all denied
</FilesMatch>

# produccion (raiz del dominio): /404.php
# en XAMPP local (bajo /form.mx) seria: ErrorDocument 404 /form.mx/404.php
ErrorDocument 404 /404.php
